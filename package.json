{
  "name": "nextomic-builder",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter editor dev",
    "build": "bun run --filter editor build",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:node": "node ./node_modules/vitest/vitest.mjs run",
    "deps:manifest": "bun run scripts/deps-manifest.ts",
    "icons:build": "bun run scripts/build-icon-set.ts",
    "icons:lint": "bun run scripts/lint-icons.ts",
    "postinstall": "bun run icons:build",
    "prepare": "husky",
    "schema:doc": "bun run scripts/gen-schema-doc.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/ph": "1.2.2",
    "@iconify/utils": "3.1.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "zod-to-json-schema": "3.25.2",
    "vite": "8.3.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.1"
  }
}
