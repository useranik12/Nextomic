{
  "name": "nextomic-builder",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter editor dev",
    "lint": "bunx eslint apps packages scripts drizzle.config.ts eslint.config.mjs",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:node": "node --import tsx --test \"packages/**/*.test.ts\"",
    "deps:manifest": "bun scripts/generate-dependency-manifest.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
