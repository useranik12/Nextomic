{
  "$schema": "nextomic-builder-ui-tokens-v1",
  "meta": {
    "name": "Nextomic Builder UI",
    "version": "1.0.0",
    "source": "blueprint/design-system/design-system-sheet.png (Figma). The sheet is the HeroUI Figma kit (heroui.org); component names, variants and token names follow HeroUI.",
    "scope": "BUILDER UI ONLY. Never used for built-site CSS (see docs/design-system.md).",
    "defaultMode": "dark",
    "verification": "Scales 500-900 of each color were sampled from the sheet and match the values below; 50-400 and layout/content values follow the same HeroUI palette. Re-check against the image before changing anything."
  },
  "fontFamily": {
    "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "typography": {
    "tiny": { "fontSize": "0.75rem", "lineHeight": "1rem" },
    "small": { "fontSize": "0.875rem", "lineHeight": "1.25rem" },
    "medium": { "fontSize": "1rem", "lineHeight": "1.5rem" },
    "large": { "fontSize": "1.125rem", "lineHeight": "1.75rem" }
  },
  "radius": {
    "small": "8px",
    "medium": "12px",
    "large": "14px",
    "full": "9999px",
    "note": "Figma shows rounded-full as 50% of height; use 9999px in CSS."
  },
  "spacing": {
    "unit": "4px",
    "note": "HeroUI spacing scale: unit-0=0, unit-1=4px, unit-2=8px, unit-3=12px, unit-3_5=14px, unit-4=16px, unit-5=20px, unit-6=24px, unit-7=28px, unit-8=32px, unit-9=36px, unit-10=40px and so on (4px steps; see the Spacing frame in the sheet)."
  },
  "breakpoints": {
    "note": "Tailwind defaults, per the Breakpoints frame. These are for the BUILDER UI. Built sites use the project's own breakpoints (base/tablet/mobile).",
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "modes": {
    "dark": {
      "layout": {
        "background": "#000000",
        "foreground": "#ECEDEE",
        "divider": "rgba(255,255,255,0.15)",
        "focus": "#006FEE"
      },
      "content": {
        "content1": "#18181B",
        "content2": "#27272A",
        "content3": "#3F3F46",
        "content4": "#52525B"
      },
      "colors": {
        "default": { "50": "#18181B", "100": "#27272A", "200": "#3F3F46", "300": "#52525B", "400": "#71717A", "500": "#A1A1AA", "600": "#D4D4D8", "700": "#E4E4E7", "800": "#F4F4F5", "900": "#FAFAFA", "DEFAULT": "#3F3F46", "foreground": "#FFFFFF" },
        "primary": { "50": "#001731", "100": "#002E62", "200": "#004493", "300": "#005BC4", "400": "#006FEE", "500": "#338EF7", "600": "#66AAF9", "700": "#99C7FB", "800": "#CCE3FD", "900": "#E6F1FE", "DEFAULT": "#006FEE", "foreground": "#FFFFFF" },
        "secondary": { "50": "#180828", "100": "#301050", "200": "#481878", "300": "#6020A0", "400": "#7828C8", "500": "#9353D3", "600": "#AE7EDE", "700": "#C9A9E9", "800": "#E4D4F4", "900": "#F2EAFA", "DEFAULT": "#9353D3", "foreground": "#FFFFFF" },
        "success": { "50": "#052814", "100": "#095028", "200": "#0E793C", "300": "#12A150", "400": "#17C964", "500": "#45D483", "600": "#74DFA2", "700": "#A2E9C1", "800": "#D1F4E0", "900": "#E8FAF0", "DEFAULT": "#17C964", "foreground": "#000000" },
        "warning": { "50": "#312107", "100": "#62420E", "200": "#936316", "300": "#C4841D", "400": "#F5A524", "500": "#F7B750", "600": "#F9C97C", "700": "#FBDBA7", "800": "#FDEDD3", "900": "#FEFCE8", "DEFAULT": "#F5A524", "foreground": "#000000" },
        "danger": { "50": "#310413", "100": "#610726", "200": "#920B3A", "300": "#C20E4D", "400": "#F31260", "500": "#F54180", "600": "#F871A0", "700": "#FAA0BF", "800": "#FDD0DF", "900": "#FEE7EF", "DEFAULT": "#F31260", "foreground": "#FFFFFF" }
      }
    },
    "light": {
      "layout": {
        "background": "#FFFFFF",
        "foreground": "#11181C",
        "divider": "rgba(17,17,17,0.15)",
        "focus": "#006FEE"
      },
      "content": {
        "content1": "#FFFFFF",
        "content2": "#F4F4F5",
        "content3": "#E4E4E7",
        "content4": "#D4D4D8"
      },
      "colors": {
        "default": { "50": "#FAFAFA", "100": "#F4F4F5", "200": "#E4E4E7", "300": "#D4D4D8", "400": "#A1A1AA", "500": "#71717A", "600": "#52525B", "700": "#3F3F46", "800": "#27272A", "900": "#18181B", "DEFAULT": "#D4D4D8", "foreground": "#000000" },
        "primary": { "50": "#E6F1FE", "100": "#CCE3FD", "200": "#99C7FB", "300": "#66AAF9", "400": "#338EF7", "500": "#006FEE", "600": "#005BC4", "700": "#004493", "800": "#002E62", "900": "#001731", "DEFAULT": "#006FEE", "foreground": "#FFFFFF" },
        "secondary": { "50": "#F2EAFA", "100": "#E4D4F4", "200": "#C9A9E9", "300": "#AE7EDE", "400": "#9353D3", "500": "#7828C8", "600": "#6020A0", "700": "#481878", "800": "#301050", "900": "#180828", "DEFAULT": "#7828C8", "foreground": "#FFFFFF" },
        "success": { "50": "#E8FAF0", "100": "#D1F4E0", "200": "#A2E9C1", "300": "#74DFA2", "400": "#45D483", "500": "#17C964", "600": "#12A150", "700": "#0E793C", "800": "#095028", "900": "#052814", "DEFAULT": "#17C964", "foreground": "#000000" },
        "warning": { "50": "#FEFCE8", "100": "#FDEDD3", "200": "#FBDBA7", "300": "#F9C97C", "400": "#F7B750", "500": "#F5A524", "600": "#C4841D", "700": "#936316", "800": "#62420E", "900": "#312107", "DEFAULT": "#F5A524", "foreground": "#000000" },
        "danger": { "50": "#FEE7EF", "100": "#FDD0DF", "200": "#FAA0BF", "300": "#F871A0", "400": "#F54180", "500": "#F31260", "600": "#C20E4D", "700": "#920B3A", "800": "#610726", "900": "#310413", "DEFAULT": "#F31260", "foreground": "#FFFFFF" }
      }
    }
  },
  "semantics": {
    "dynamicDataBolt": "warning.DEFAULT",
    "httpMethodBadges": {
      "GET": "success",
      "POST": "secondary",
      "PUT": "warning",
      "PATCH": "warning",
      "DELETE": "danger"
    },
    "note": "The bolt (dynamic data) icon is amber/yellow in the designs. Method badge colors are read from the API Data screens: GET green, POST purple, PATCH amber, PUT orange, DELETE pink/red; a muted/red-x POST badge means the call is inactive."
  }
}
