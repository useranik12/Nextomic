# For local dev (bun run dev), copy this to apps/editor/.env.local.
# For docker-compose, the root .env.example is copied to the repo root .env instead.
# Keep both in sync — see ../../.env.example for the canonical list with comments.

DATABASE_URL=postgres://nextomic:nextomic@localhost:5432/nextomic
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=true
STORAGE_ADAPTER=local
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
DEV_EMAIL_TO_CONSOLE=true
