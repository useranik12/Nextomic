# Supabase: the builder keeps everything here (Auth, the nextomic_builder schema, the public users
# tables). Run the migrations with `bun run --filter @nextomic/db migrate`.
# DATABASE_URL must be a SESSION-mode connection (Supavisor session port 5432, or the database), never
# the transaction pooler. Use the postgres.<tenant> user of the pooler.
DATABASE_URL=postgres://postgres.your-tenant:change-me@localhost:54322/postgres
# The API gateway and its publishable key. Server side only: the browser never talks to Supabase.
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Used by tests to create accounts (never reaches the app).
SUPABASE_SECRET_KEY=sb_secret_replace-me
# Docker only: how the containers reach Supabase (the shared network). Falls back to the two above.
DATABASE_URL_INTERNAL=
SUPABASE_URL_INTERNAL=
# The builder's public address (no path), used for links in auth emails and secure cookies.
APP_URL=http://localhost:3000
# Password rules for builder accounts (sign up, reset, change). One of:
#   basic        at least 8 characters
#   medium       at least 10 characters, a lowercase letter and a number (default)
#   strong       at least 12 characters, upper and lowercase letters, a number and a symbol
#   very-strong  at least 16 characters, upper and lowercase letters, a number and a symbol
# Also set GOTRUE_PASSWORD_MIN_LENGTH and GOTRUE_PASSWORD_REQUIRED_CHARACTERS on Supabase Auth to match.
AUTH_PASSWORD_POLICY=medium

# Connector secrets (Supabase keys, API tokens) are encrypted with AES-256-GCM using this key.
# 32 bytes, base64: `openssl rand -base64 32`. Keep it safe: losing it makes saved secrets unreadable.
# To rotate: move the old key into ENCRYPTION_PREVIOUS_KEYS as `version:key`, set a new key and
# raise ENCRYPTION_KEY_VERSION. Secrets are re-encrypted with the new key when next saved.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_PREVIOUS_KEYS=
# Development only: let connectors reach localhost and private networks (never in production;
# cloud metadata addresses stay blocked either way).
ALLOW_PRIVATE_CONNECTOR_HOSTS=false

# Admin: allow or disallow public signup (env-driven until App Settings ships the full control)
ALLOW_SIGNUP=true

# Where builder files go. "supabase" (default) uses Supabase Storage with SUPABASE_SECRET_KEY above;
# "local" writes to disk and is for unit tests only. The buckets are created by the migrations.
STORAGE_ADAPTER=supabase

# Optional: a real Supabase project for the Supabase connector tests (live unit check and
# e2e/supabase.spec.ts). Tests skip when unset. Only the anon key is used.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
