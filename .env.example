# Platform database (own Postgres 18 in docker-compose.yml; never shared with Supabase/REST integrations)
# Compose builds the container's DATABASE_URL from these three. Set a strong password in Dokploy.
POSTGRES_USER=nextomic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nextomic
# Host-side URL for `bun run dev` and migrations run outside Docker (needs docker-compose.dev.yml)
DATABASE_URL=postgres://nextomic:change-me@localhost:5432/nextomic

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The builder's public address, e.g. https://nextomic.example.com (no path). Used for links in
# auth emails and as the only origin allowed to sign in. Must match the browser address exactly.
BETTER_AUTH_URL=http://localhost:3000
# Optional extra origins allowed to sign in (comma-separated), e.g. a second domain.
BETTER_AUTH_TRUSTED_ORIGINS=
# Password rules for builder accounts (sign up, reset, change). One of:
#   basic        at least 8 characters
#   medium       at least 10 characters, a lowercase letter and a number (default)
#   strong       at least 12 characters, upper and lowercase letters, a number and a symbol
#   very-strong  at least 16 characters, upper and lowercase letters, a number and a symbol
# Existing passwords keep working; the rule applies when a password is set.
AUTH_PASSWORD_POLICY=medium

# Connector secrets (Supabase keys, API tokens) are encrypted with AES-256-GCM using this key.
# 32 bytes, base64: `openssl rand -base64 32`. Keep it safe: losing it makes saved secrets unreadable.
# To rotate: move the old key into ENCRYPTION_PREVIOUS_KEYS as `version:key`, set a new key and
# raise ENCRYPTION_KEY_VERSION. Secrets are re-encrypted with the new key when next saved.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_PREVIOUS_KEYS=
# Development only: let connectors reach localhost and private networks (never in production;
# cloud metadata addresses stay blocked either way).
ALLOW_PRIVATE_CONNECTOR_HOSTS=false

# Admin: allow or disallow public signup (env-driven until App Settings ships the full control)
ALLOW_SIGNUP=true

# Storage adapter: "local" or "s3"
STORAGE_ADAPTER=local
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage

# S3-compatible storage (only read when STORAGE_ADAPTER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# SMTP for all email (builder verification and password reset; built apps use their own SMTP_*
# variables). There is no SMTP screen in the builder. Leave SMTP_HOST empty to run without email:
# verification is then NOT required (so the first user can register).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); leave empty to default to true only on 465.
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Nextomic <no-reply@example.com>"

# Dev-only: with no SMTP, log auth email links to the server console instead of failing
DEV_EMAIL_TO_CONSOLE=true
