# Platform database. Never use a connected Supabase database here.
DATABASE_URL=postgresql://nextomic:change-me@localhost:5432/nextomic

# At least 32 high-entropy characters. Generate this locally; do not commit a value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for verification and password-reset email in a production environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Nextomic <no-reply@example.com>"

# Local storage is the default. S3 settings remain optional until configured.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
