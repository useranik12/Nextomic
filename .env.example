# Platform database (own Postgres 18 in docker-compose.yml; never shared with Supabase/REST integrations)
# Compose builds the container's DATABASE_URL from these three. Set a strong password in Dokploy.
POSTGRES_USER=nextomic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nextomic
# Host-side URL for `bun run dev` and migrations run outside Docker (needs docker-compose.dev.yml)
DATABASE_URL=postgres://nextomic:change-me@localhost:5432/nextomic

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Admin: allow or disallow public signup (env-driven until App Settings ships the full control)
ALLOW_SIGNUP=true

# Storage adapter: "local" or "s3"
STORAGE_ADAPTER=local
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage

# S3-compatible storage (only read when STORAGE_ADAPTER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Dev-only: log auth emails to the console instead of sending (multi-SMTP is Phase 12)
DEV_EMAIL_TO_CONSOLE=true
